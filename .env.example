SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-only-service-role-key

MINECRAFT_HOST=8b8t.me
MINECRAFT_PORT=25565
MINECRAFT_USERNAME=your-minecraft-account
# Optional server /login password. Keep it only in the ignored .env file.
MINECRAFT_PASSWORD=
# Set to microsoft for Microsoft authentication; omit when the server uses /login.
# MINECRAFT_AUTH=microsoft
# Optional protocol version, e.g. 1.20.4. Leave unset for Mineflayer auto-detection.
# MINECRAFT_VERSION=1.20.4

RECONNECT_DELAY_MS=10000
HOME_COMMAND_DELAY_MS=5000
ANTI_AFK_INTERVAL_MS=60000
# World spawn X/Z used for the leader-help radius check.
SPAWN_X=0
SPAWN_Z=0
# Optional server confirmation handling for the no-leader /kill fallback.
KILL_CONFIRM_REGEX=(?:kill|respawn).{0,80}(?:confirm|sure|accept)|(?:confirm|sure|accept).{0,80}(?:kill|respawn)
KILL_CONFIRM_COMMAND=/kill confirm
TPA_TIMEOUT_MS=120000
TPA_ACCEPT_REGEX=(?:teleport(?:ation)?(?: request)?|tpa).{0,80}(?:accepted|approved)|(?:accepted|approved).{0,80}(?:teleport|tpa)
